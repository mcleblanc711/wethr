[Unit]
Description=Wethr daily observations, settlement, and reconciliation
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
WorkingDirectory=%h/projects/wethr/collector
Environment=WETHR_LIVE=0
# Optional: send calibration alerts to ntfy.
# Environment=WETHR_NTFY_TOPIC_URL=
ExecStart=%h/projects/wethr/collector/.venv/bin/python -m scripts.daily_calibration
