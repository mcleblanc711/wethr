[Unit]
Description=Wethr monthly immutable archive and candidate training

[Service]
Type=oneshot
WorkingDirectory=%h/projects/wethr/collector
Environment=WETHR_LIVE=0
# Optional: send calibration alerts to ntfy.
# Environment=WETHR_NTFY_TOPIC_URL=
ExecStart=%h/projects/wethr/collector/.venv/bin/python -m scripts.monthly_calibration
