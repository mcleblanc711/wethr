#!/usr/bin/env bash
set -euo pipefail

readonly REQUIRED_UV_VERSION="0.11.32"
readonly SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
readonly REPO_ROOT="$(cd "$SCRIPT_DIR/.." && pwd)"
readonly COLLECTOR_DIR="$REPO_ROOT/collector"

die() {
    printf 'check: error: %s\n' "$*" >&2
    exit 1
}

require_command() {
    local command_name="$1"
    local install_hint="$2"

    command -v "$command_name" >/dev/null 2>&1 ||
        die "required command '$command_name' was not found; $install_hint"
}

explicit_base=""
while (($# > 0)); do
    case "$1" in
        --base)
            (($# >= 2)) || die "--base requires a Git reference"
            [[ -n "$2" ]] || die "--base requires a non-empty Git reference"
            explicit_base="$2"
            shift 2
            ;;
        *)
            die "unknown argument '$1'; usage: ./scripts/check [--base <git-ref>]"
            ;;
    esac
done

require_command uv "install uv $REQUIRED_UV_VERSION from https://docs.astral.sh/uv/"
require_command git "install Git and retry"
require_command docker "install Docker with the Compose plugin and retry"
require_command systemd-analyze "install systemd tooling and retry"

uv_version="$(uv --version 2>/dev/null || true)"
[[ "$uv_version" == "uv $REQUIRED_UV_VERSION"* ]] ||
    die "uv $REQUIRED_UV_VERSION is required, but found '${uv_version:-an unusable uv command}'"

docker compose version >/dev/null 2>&1 ||
    die "'docker compose' is unavailable; install the Docker Compose plugin and retry"
systemd-analyze --version >/dev/null 2>&1 ||
    die "'systemd-analyze' is unavailable or unusable; install systemd tooling and retry"

resolved_root="$(git -C "$REPO_ROOT" rev-parse --show-toplevel 2>/dev/null)" ||
    die "'$REPO_ROOT' is not inside a Git worktree"
[[ "$resolved_root" == "$REPO_ROOT" ]] ||
    die "script resolved '$REPO_ROOT', but Git resolved '$resolved_root'"

base_ref=""
base_commit=""
if [[ -n "$explicit_base" ]]; then
    base_ref="$explicit_base"
    base_commit="$(git -C "$REPO_ROOT" rev-parse --verify --quiet "${base_ref}^{commit}")" ||
        die "explicit diff base '$base_ref' does not resolve to a commit"
elif [[ -n "${WETHR_DIFF_BASE:-}" && ! "${WETHR_DIFF_BASE}" =~ ^0+$ ]]; then
    base_ref="$WETHR_DIFF_BASE"
    base_commit="$(git -C "$REPO_ROOT" rev-parse --verify --quiet "${base_ref}^{commit}")" ||
        die "WETHR_DIFF_BASE '$base_ref' does not resolve to a commit"
else
    for candidate in origin/main main; do
        if candidate_commit="$(git -C "$REPO_ROOT" rev-parse --verify --quiet "${candidate}^{commit}")"; then
            base_ref="$candidate"
            base_commit="$candidate_commit"
            break
        fi
    done
    [[ -n "$base_commit" ]] ||
        die "no diff base resolves; pass --base, set WETHR_DIFF_BASE, or fetch origin/main"
fi

head_commit="$(git -C "$REPO_ROOT" rev-parse --verify HEAD)"
merge_base="$(git -C "$REPO_ROOT" merge-base "$base_commit" "$head_commit")" ||
    die "diff base '$base_ref' and HEAD have no merge base"

workflow_files=()
while IFS= read -r file; do
    [[ -n "$file" ]] && workflow_files+=("$file")
done < <(git -C "$REPO_ROOT" ls-files 'n8n-wethr/workflows/*.json')
(( ${#workflow_files[@]} > 0 )) ||
    die "no tracked n8n workflow JSON files found under n8n-wethr/workflows/"

unit_files=()
while IFS= read -r file; do
    [[ -n "$file" ]] && unit_files+=("$file")
done < <(git -C "$REPO_ROOT" ls-files 'deploy/systemd/*.service' 'deploy/systemd/*.timer')
(( ${#unit_files[@]} > 0 )) ||
    die "no tracked systemd service or timer units found under deploy/systemd/"

compose_files=()
while IFS= read -r file; do
    case "$file" in
        compose.yml|compose.yaml|docker-compose.yml|docker-compose.yaml|*/compose.yml|*/compose.yaml|*/docker-compose.yml|*/docker-compose.yaml)
            compose_files+=("$file")
            ;;
    esac
done < <(git -C "$REPO_ROOT" ls-files)
(( ${#compose_files[@]} > 0 )) ||
    die "no tracked Compose files found"

check_tmp="$(mktemp -d "${TMPDIR:-/tmp}/wethr-check.XXXXXX")"
cleanup() {
    rm -rf -- "$check_tmp"
}
trap cleanup EXIT

export WETHR_LIVE=0
export WETHR_DATA_DIR="$check_tmp/data"
export WETHR_DB_PATH="$WETHR_DATA_DIR/wethr.db"
export PYTHONPYCACHEPREFIX="$check_tmp/pycache"
mkdir -p "$WETHR_DATA_DIR"

printf 'check: syncing locked Python environment with uv %s\n' "$REQUIRED_UV_VERSION"
(
    cd "$COLLECTOR_DIR"
    uv sync --locked
)

printf 'check: running pytest with network socket access disabled\n'
(
    cd "$COLLECTOR_DIR"
    uv run python -m pytest -q --disable-socket --allow-unix-socket -p no:cacheprovider
)

printf 'check: compiling collector/src and collector/scripts\n'
(
    cd "$COLLECTOR_DIR"
    uv run python -m compileall -q src scripts
)

printf 'check: parsing %d tracked n8n workflow JSON file(s)\n' "${#workflow_files[@]}"
for file in "${workflow_files[@]}"; do
    (
        cd "$COLLECTOR_DIR"
        uv run python -m json.tool "$REPO_ROOT/$file" >/dev/null
    ) || die "malformed workflow JSON: $file"
done

printf 'check: validating %d tracked Compose file(s)\n' "${#compose_files[@]}"
for file in "${compose_files[@]}"; do
    docker compose -f "$REPO_ROOT/$file" config -q ||
        die "invalid Compose configuration: $file"
done

printf 'check: validating %d tracked systemd unit(s)\n' "${#unit_files[@]}"
unit_verify_dir="$check_tmp/systemd"
# The installed user units target %h/projects/wethr. Resolve only that checkout
# prefix in temporary copies so the same syntax check works in local and CI
# paths without mutating the tracked units.
mkdir -p "$unit_verify_dir"
unit_paths=()
for file in "${unit_files[@]}"; do
    unit_path="$unit_verify_dir/${file##*/}"
    while IFS= read -r line || [[ -n "$line" ]]; do
        printf '%s\n' "${line//%h\/projects\/wethr/$REPO_ROOT}"
    done <"$REPO_ROOT/$file" >"$unit_path"
    unit_paths+=("$unit_path")
done
systemd_output="$check_tmp/systemd-analyze.log"
if ! systemd-analyze verify --user "${unit_paths[@]}" >"$systemd_output" 2>&1; then
    while IFS= read -r line; do
        printf '%s\n' "$line" >&2
    done <"$systemd_output"
    die "systemd unit validation failed"
fi
if [[ -s "$systemd_output" ]]; then
    while IFS= read -r line; do
        printf '%s\n' "$line" >&2
    done <"$systemd_output"
    die "systemd unit validation reported diagnostics"
fi

printf "check: checking committed whitespace from merge base %s (%s)\n" \
    "${merge_base:0:12}" "$base_ref"
git -C "$REPO_ROOT" diff --check "$merge_base" "$head_commit" ||
    die "whitespace errors found in committed branch changes"

printf 'check: checking staged whitespace\n'
git -C "$REPO_ROOT" diff --cached --check ||
    die "whitespace errors found in staged changes"

printf 'check: checking unstaged whitespace\n'
git -C "$REPO_ROOT" diff --check ||
    die "whitespace errors found in unstaged changes"

printf 'check: all checks passed\n'
